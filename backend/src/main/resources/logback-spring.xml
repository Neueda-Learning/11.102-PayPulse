<?xml version="1.0" encoding="UTF-8"?>
<!--
  PayPulse logging configuration.

  SECURITY (Log Sanitization / PII): financial log lines must never leak card
  numbers, CVVs, or full account numbers to disk / Loki. We apply %replace regex
  masking on the message BEFORE it is written to any appender, so masked data
  never reaches Promtail -> Loki -> Grafana.
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
      NOTE: Logback's %replace OptionTokenizer counts raw '{' / '}' characters to find
      the end of its own {regex, replacement} block — even inside quoted strings. Any
      literal brace in the regex (e.g. quantifiers like \d{3,19}) breaks parsing with
      "Unexpected end of pattern string". So the masking regexes below are written
      WITHOUT curly-brace quantifiers (using repeated \d / \d? instead).
    -->
    <property name="MASKED_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %replace(%replace(%replace(%msg){'(?i)(&quot;?(cardNumber|cvv|cvc|pan)&quot;?\s*[:=]\s*&quot;?)\d\d\d[0-9]*', '$1****MASKED****'}){'\b\d\d\d\d[- ]?\d\d\d\d[- ]?\d\d\d\d[- ]?\d\d?\d?\d?\b', '****-****-****-****'}){'(?i)(&quot;?password&quot;?\s*[:=]\s*&quot;?)[^,\s]+', '$1****MASKED****'}%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${MASKED_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.paypulse" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>

</configuration>


