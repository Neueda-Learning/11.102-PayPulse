# PayPulse — Environment Variables
# These credentials are used by all three containers (MySQL, backend, frontend).
# Do NOT commit a different .env with production secrets — use .env.local for overrides.

# MySQL
MYSQL_ROOT_PASSWORD=n3u3da!
MYSQL_DATABASE=paypulse
# App connects as root (single-developer setup — see README for production note)
MYSQL_USER=root
MYSQL_PASSWORD=n3u3da!

# Spring Boot
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# Frontend nginx internal port
FRONTEND_PORT=80

